PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/unahur-tp
REDIS_URL=redis://localhost:6380
NODE_ENV=development

JWT_SECRET=colocar_clave_secreta_aqui
# Orígenes permitidos por CORS (coma-separados, default solo el front local)
CORS_ORIGIN=http://localhost:5173
# IA (fallback en carga de PDFs: Gemini -> Groq de respaldo)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Control de la capa IA (opcional: los defaults son los valores históricos)
# Timeout por request al proveedor y espera del reintento ante 429/5xx
AI_TIMEOUT_MS=60000
AI_RETRY_MS=3000
# Cupo de parses con IA por ventana (rate limit de /parse-official y /parse-correlativas)
AI_RATE_WINDOW_MS=900000
AI_RATE_MAX=10
# Diagnóstico del parser (logs [corr]/[pmerge]; solo dev)
# PARSE_DEBUG=corr
# PARSE_PAGE=17
