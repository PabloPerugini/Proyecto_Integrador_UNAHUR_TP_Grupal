PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/unahur-tp
REDIS_URL=redis://localhost:6380
NODE_ENV=development

# Auth (JWT en cookie httpOnly) — OBLIGATORIO. Generá un secreto largo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El arranque falla si JWT_SECRET queda vacío o con el valor de ejemplo.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# En producción con HTTPS poné COOKIE_SECURE=true
COOKIE_SECURE=false

# Debug del parser de PDFs
# PARSE_DEBUG=1

# IA — orientador (chat). El primero configurado gana; Ollama es local y gratis.
# GROQ_API_KEY=tu_clave_groq
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=tu_clave_gemini
# GEMINI_MODEL=gemini-3.6-flash
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# IA — matching semántico de materias (local, sin API; modelo gratuito de Hugging Face)
# EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDINGS_MIN_SIMILARITY=0.8